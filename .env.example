# Standard single-provider setup
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: specialist multi-provider registry used by the autonomous workflow.
# This must be a single-line JSON string.
SELF_DEPENDENT_PROVIDERS={"research_a":{"api_key":"your_api_key_here","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","capabilities":["research"]},"coding_a":{"api_key":"your_api_key_here","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","capabilities":["coding"]},"verification_a":{"api_key":"your_api_key_here","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","capabilities":["verification"]},"review_a":{"api_key":"your_api_key_here","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","capabilities":["review"]}}
